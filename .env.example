# =====================================================================
#  Majster-AI / Car_Diagnostic_AI (CDA) - example configuration
# =====================================================================
#  Copy to `.env` and edit.  `.env` is gitignored: never commit real keys.
#
#      cp .env.example .env
#
#  Every value below is a default that ships in the code, so an empty .env
#  is a valid .env.  Uncomment only what you need to change.
# =====================================================================

# ---------------------------------------------------------------------
# 1. SAFETY  --  read this section before touching anything else
# ---------------------------------------------------------------------
# Master switch for every write operation (clear_dtc, adaptations, resets).
# While false the agent is strictly READ_ONLY and refuses writes outright.
# Leave it false unless you are actively performing a repair.
MAJSTER_WRITE_ENABLED=false

# Human-in-the-loop. When true (the default) every write pauses the agent and
# waits for you to type an explicit confirmation. Setting this to false is for
# automated bench rigs ONLY -- never on a vehicle you care about.
MAJSTER_REQUIRE_APPROVAL=true

# Seconds to wait for your decision before aborting the operation.
MAJSTER_APPROVAL_TIMEOUT=300

# ---------------------------------------------------------------------
# 2. VEHICLE INTERFACE
# ---------------------------------------------------------------------
# Backend: virtual | socketcan | slcan | serial | j2534 | rfcomm
#   virtual   - built-in Freelander 2 ECU simulator. No hardware. THE DEFAULT.
#   socketcan - Linux SocketCAN. Use `vcan0` for a virtual bus, `can0` for real.
#   slcan     - CANable / CANtact running slcan firmware, on a serial port.
#   serial    - python-can's generic serial transport.
#   j2534     - SAE J2534 PassThru (Tactrix Openport 2.0).
#   rfcomm    - ELM327-class adapter over a Bluetooth RFCOMM serial port.
MAJSTER_CAN_BACKEND=virtual

# Channel meaning depends on the backend:
#   socketcan -> can0 / vcan0
#   slcan/serial/rfcomm -> /dev/ttyUSB0, /dev/ttyACM0, /dev/rfcomm0
#   j2534 -> ignored (the device is selected by the library below)
MAJSTER_CAN_CHANNEL=vcan0

# Freelander 2 diagnostic CAN runs at 500 kbit/s.
MAJSTER_CAN_BITRATE=500000

# Absolute path to the J2534 PassThru shared library. REQUIRED when
# MAJSTER_CAN_BACKEND=j2534. Tactrix Openport 2.0 ships `op20pt32`.
#   Linux : /usr/local/lib/libop20pt32.so
#   Windows: C:\Program Files (x86)\OpenECU\OpenPort 2.0\drivers\op20pt32.dll
#MAJSTER_J2534_LIBRARY=/usr/local/lib/libop20pt32.so

# ---------------------------------------------------------------------
# 3. UDS TIMING  --  CAN is flaky; these control how hard we retry
# ---------------------------------------------------------------------
# P2 client timeout: how long to wait for a first response (seconds).
MAJSTER_UDS_TIMEOUT=2.0
# P2* timeout: applied after the ECU replies "response pending" (NRC 0x78).
MAJSTER_UDS_EXTENDED_TIMEOUT=5.0
# Retry attempts for a timed-out or transiently-busy request.
MAJSTER_UDS_RETRIES=2
# Base seconds for exponential backoff between retries (0.25 -> 0.25, 0.5, 1.0).
MAJSTER_UDS_RETRY_BACKOFF=0.25
# Consecutive NRC 0x78 frames tolerated before giving up.
MAJSTER_UDS_MAX_RESPONSE_PENDING=10

# ---------------------------------------------------------------------
# 4. LLM
# ---------------------------------------------------------------------
# Provider: anthropic | ollama | auto
#   auto -> Anthropic when ANTHROPIC_API_KEY is set, otherwise Ollama.
MAJSTER_LLM_PROVIDER=auto

# --- Anthropic (Claude) ---
# Get a key at https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=sk-ant-...
MAJSTER_LLM_MODEL=claude-opus-5
MAJSTER_LLM_MAX_TOKENS=16000
# Adaptive extended thinking. Recommended: diagnosis is multi-step reasoning.
MAJSTER_LLM_THINKING=true

# --- Ollama (offline fallback, e.g. in a garage with no signal) ---
# Install: https://ollama.com  then: ollama pull qwen2.5:7b-instruct
MAJSTER_OLLAMA_BASE_URL=http://localhost:11434
MAJSTER_OLLAMA_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------
# 5. RAG  --  workshop manuals
# ---------------------------------------------------------------------
# Drop your workshop manual PDFs here, then run: majster-ai ingest
MAJSTER_MANUALS_DIR=./data/manuals
MAJSTER_VECTOR_DIR=./data/vectorstore
MAJSTER_RAG_COLLECTION=workshop_manuals

# Local embedding model (sentence-transformers). If the package is not
# installed the store falls back to a deterministic hash embedder, which keeps
# everything working on a bare Termux box at reduced retrieval quality.
MAJSTER_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAJSTER_RAG_CHUNK_SIZE=1200
MAJSTER_RAG_CHUNK_OVERLAP=200
MAJSTER_RAG_TOP_K=5

# ---------------------------------------------------------------------
# 6. WEB SEARCH
# ---------------------------------------------------------------------
# Tavily is used when a key is present; otherwise DuckDuckGo (keyless).
# Get a key at https://app.tavily.com
#TAVILY_API_KEY=tvly-...
MAJSTER_WEB_MAX_RESULTS=5
MAJSTER_WEB_TIMEOUT=20
# Forums whose results get ranked higher, comma-separated.
MAJSTER_WEB_PREFERRED_DOMAINS=freel2.com,landyzone.co.uk,difflock.com,landroverforums.com

# ---------------------------------------------------------------------
# 7. LOGGING
# ---------------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
#   INFO  -> agent reasoning steps
#   DEBUG -> every CAN frame, Tx and Rx
MAJSTER_LOG_LEVEL=INFO
# Trace bus traffic without turning the whole tree to DEBUG.
MAJSTER_LOG_CAN_FRAMES=false
# Machine-readable JSON log records.
MAJSTER_LOG_JSON=false
# Rotating log file (10 MB x 5). Unset = stderr only.
#MAJSTER_LOG_FILE=./data/majster.log
